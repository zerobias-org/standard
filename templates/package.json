{
  "name": "@zerobias-org/standard-{vendor}-{suite}-{version}",
  "version": "1.0.0",
  "description": "{standardName}",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/standard.git",
    "directory": "package/{type}/{vendor}/{suite}/{version}/"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org/"
  },
  "files": [
    "index.yml",
    "elements/**"
  ],
  "zerobias": {
    "dataloader-version": "1.0.0",
    "import-artifact": "standard",
    "package": "{vendor}.{suite}.{version}.standard",
    "orgId": "{target-org-uuid}"
  },
  "dependencies": {
    "@zerobias-org/suite-{vendor}-{suite}": "latest"
  }
}
